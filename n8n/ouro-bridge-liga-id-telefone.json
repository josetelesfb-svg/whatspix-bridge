    {
      "id": "c3218efe-661f-5173-affd-13529b64a58d",
      "name": "Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "jsCode": "// Chamado pela integração no início do fluxo da Leona. Precisa de \"telefone\" ({phone_number}).\nconst b = $input.first().json.body || {};\nconst telefone = String(b.telefone ?? (b.contact && b.contact.number) ?? '').replace(/\\D/g, '');\nif (!telefone) return [];\nconst agora = Date.now();\nconst JANELA_MIN = 10; // procura toques no botão nos últimos X minutos\nconst m = String(b.mensagem ?? '').match(/(?:\\[ID:|c[oó]digo de atendimento:?\\s*)([a-z0-9]{6,16})/i);\nreturn [{ json: {\n  telefone,\n  codigo: m ? m[1].toLowerCase() : '',\n  agora: new Date(agora).toISOString(),\n  desde: new Date(agora - JANELA_MIN * 60 * 1000).toISOString(),\n} }];"
      }
    },
    {
      "id": "3a6c5956-11ff-55dd-988d-3ec7991dc8fa",
      "name": "Toques recentes sem dono",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        520,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "3HxLTtbOps3mWweq",
          "cachedResultName": "ouro_bridge_cliques"
        },
        "returnAll": true,
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "telefone",
              "condition": "isEmpty"
            },
            {
              "keyName": "whatsapp_em",
              "condition": "gte",
              "keyValue": "={{ $json.desde }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b9e8725f-f7a2-5d79-b513-305cef82396e",
      "name": "Escolher clique",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "jsCode": "// Entre os toques no botão sem telefone na janela, escolhe o código (se veio) ou o mais recente.\nconst p = $('Preparar').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.id_curto && r.whatsapp_em && r.whatsapp_em <= p.agora);\nif (!rows.length) return [];\nlet escolhido = p.codigo ? rows.find(r => r.id_curto === p.codigo) : null;\nlet via = 'codigo';\nif (!escolhido) {\n  rows.sort((a, b) => (a.whatsapp_em < b.whatsapp_em ? 1 : -1));\n  escolhido = rows[0];\n  via = rows.length === 1 ? 'horario' : 'horario_' + rows.length + '_candidatos';\n}\nreturn [{ json: { id_curto: escolhido.id_curto, telefone: p.telefone, lead_em: p.agora, casado_por: via } }];"
      }
    },
